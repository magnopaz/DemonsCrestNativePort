# Physics probe that stays inside the starting graveyard room.
# Dumps and WRAM trace are paired so the player object and OAM can be compared.
turbo on
wait 24000
press start 4
until 008D == 02 60000
wait 600
dump p_idle
wait 60

press right 30
wait 60
dump p_right
press left 30
wait 60
dump p_left

press a 8
wait 60
dump p_jump
wait 60

press a 60
wait 60
dump p_hold
wait 30

press right+a 8
wait 30
press right 20
wait 60
dump p_fly
wait 60

quit
